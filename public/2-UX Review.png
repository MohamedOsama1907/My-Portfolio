<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="2048" height="1152" viewBox="0 0 2048 1152" role="img" aria-labelledby="title description">
<title id="title">The UX Review responsive project showcase</title>
<desc id="description">The UX Review website displayed on a laptop, tablet, and smartphone, with HTML and CSS technology badges.</desc>
<defs>
  <linearGradient id="background" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#f8f8ff"/><stop offset=".52" stop-color="#f1f0f8"/><stop offset="1" stop-color="#e8e7f1"/></linearGradient>
  <radialGradient id="glow"><stop stop-color="#fff" stop-opacity=".95"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></radialGradient>
  <linearGradient id="metal" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#d8d9df"/><stop offset=".18" stop-color="#fafaff"/><stop offset="1" stop-color="#aeb0ba"/></linearGradient>
  <linearGradient id="deviceEdge" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#34343b"/><stop offset=".5" stop-color="#08090d"/><stop offset="1" stop-color="#3a3b43"/></linearGradient>
  <filter id="shadowLarge" x="-30%" y="-30%" width="160%" height="180%"><feGaussianBlur in="SourceAlpha" stdDeviation="26"/><feOffset dy="28"/><feComponentTransfer><feFuncA type="linear" slope=".28"/></feComponentTransfer><feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge></filter>
  <filter id="shadowDevice" x="-35%" y="-35%" width="170%" height="180%"><feGaussianBlur in="SourceAlpha" stdDeviation="16"/><feOffset dy="18"/><feComponentTransfer><feFuncA type="linear" slope=".38"/></feComponentTransfer><feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge></filter>
  <filter id="badgeShadow" x="-30%" y="-50%" width="160%" height="200%"><feGaussianBlur in="SourceAlpha" stdDeviation="6"/><feOffset dy="4"/><feComponentTransfer><feFuncA type="linear" slope=".14"/></feComponentTransfer><feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge></filter>
  <clipPath id="laptopScreen"><rect x="306" y="115" width="1436" height="752" rx="17"/></clipPath>
  <clipPath id="tabletScreen"><rect x="83" y="583" width="573" height="379" rx="13"/></clipPath>
  <clipPath id="phoneScreen"><rect x="1650" y="455" width="326" height="614" rx="36"/></clipPath>
</defs>
<rect width="2048" height="1152" fill="url(#background)"/>
<ellipse cx="1015" cy="485" rx="1120" ry="790" fill="url(#glow)" opacity=".82"/>
<ellipse cx="1040" cy="1008" rx="820" ry="105" fill="#b4b1ca" opacity=".16"/>
<!-- Laptop: the original desktop screenshot is kept intact inside a realistic display frame. -->
<g filter="url(#shadowLarge)">
  <rect x="282" y="88" width="1484" height="815" rx="38" fill="url(#deviceEdge)" stroke="#595a63" stroke-width="2"/>
  <rect x="298" y="103" width="1452" height="779" rx="25" fill="#08090d"/>
  <circle cx="1024" cy="106" r="3.2" fill="#424653"/>
  <rect x="306" y="115" width="1436" height="752" rx="17" fill="#fff"/>
  <image x="306" y="115" width="1436" height="752" preserveAspectRatio="xMidYMid slice" clip-path="url(#laptopScreen)" href="data:image/png;base64,"/>
  <path d="M235 902h1578l-105 76c-10 7-24 11-39 11H386c-16 0-29-4-40-12z" fill="url(#metal)" stroke="#a9abb5" stroke-width="2"/>
  <path d="M237 903h1574l-12 10H249z" fill="#f7f7fb" opacity=".95"/>
  <rect x="841" y="915" width="366" height="10" rx="5" fill="#a4a6b0" opacity=".7"/>
</g>
<!-- Tablet: supplied responsive screenshot, framed without changing its interface. -->
<g transform="rotate(-4 370 772)" filter="url(#shadowDevice)">
  <rect x="58" y="554" width="623" height="437" rx="38" fill="url(#deviceEdge)" stroke="#555760" stroke-width="2"/>
  <rect x="72" y="568" width="595" height="409" rx="27" fill="#08090d"/>
  <circle cx="65" cy="772" r="3.2" fill="#555866"/>
  <rect x="83" y="583" width="573" height="379" rx="13" fill="#fff"/>
  <image x="83" y="583" width="573" height="379" preserveAspectRatio="xMidYMid slice" clip-path="url(#tabletScreen)" href="data:image/png;base64,"/>
</g>
<!-- Phone: supplied narrow-screen screenshot, shown at its natural portrait ratio. -->
<g transform="rotate(4 1813 762)" filter="url(#shadowDevice)">
  <rect x="1630" y="430" width="366" height="668" rx="55" fill="url(#deviceEdge)" stroke="#545660" stroke-width="2"/>
  <rect x="1640" y="440" width="346" height="648" rx="47" fill="#08090d"/>
  <rect x="1650" y="455" width="326" height="614" rx="36" fill="#fff"/>
  <image x="1650" y="455" width="326" height="614" preserveAspectRatio="xMidYMid slice" clip-path="url(#phoneScreen)" href="data:image/png;base64,"/>
  <rect x="1766" y="449" width="92" height="17" rx="9" fill="#08090d"/>
  <circle cx="1840" cy="457.5" r="3" fill="#282a31"/>
</g>
<!-- Small, secondary technology labels. -->
<g filter="url(#badgeShadow)" font-family="Arial, sans-serif" font-size="19" font-weight="700" text-anchor="middle">
  <rect x="864" y="1060" width="150" height="50" rx="25" fill="#fff" stroke="#e2e1e9"/>
  <circle cx="890" cy="1085" r="6" fill="#e95b3c"/><text x="950" y="1092" fill="#24242b">HTML</text>
  <rect x="1030" y="1060" width="138" height="50" rx="25" fill="#fff" stroke="#e2e1e9"/>
  <circle cx="1056" cy="1085" r="6" fill="#2675bd"/><text x="1111" y="1092" fill="#24242b">CSS</text>
</g>
</svg>